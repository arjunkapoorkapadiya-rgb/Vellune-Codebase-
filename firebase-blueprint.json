{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public literary member profile without PII (email isolated in users_private).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["reader", "contributor", "fellow"]
        },
        "bio": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "chapterOrInstitution": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "bio", "chapterOrInstitution", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII storage for authenticated Vellune members.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "SavedFolio": {
      "title": "SavedFolio",
      "description": "Member-saved essay, guide chapter, or reading room resource with personal margin notes.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemType": {
          "type": "string",
          "enum": ["article", "chapter", "resource"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "seriesTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "itemId", "itemType", "title", "seriesTitle", "note", "createdAt", "updatedAt"]
    },
    "SubmissionRecord": {
      "title": "SubmissionRecord",
      "description": "Cloud-synced pitch, review, fellowship, or chapter charter submission.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "trackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "trackTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "applicantName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "institution": {
          "type": "string",
          "minLength": 0,
          "maxLength": 140
        },
        "pitchText": {
          "type": "string",
          "minLength": 20,
          "maxLength": 4000
        },
        "status": {
          "type": "string",
          "enum": ["submitted", "under_review", "accepted", "archived"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "trackId", "trackTitle", "applicantName", "institution", "pitchText", "status", "createdAt", "updatedAt"]
    },
    "EventRegistration": {
      "title": "EventRegistration",
      "description": "Member RSVP for Vellune Conversations seminars and workshops.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "attendeeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "attendanceMode": {
          "type": "string",
          "enum": ["Online Seminar Livestream", "In-Person Salon Seat"]
        },
        "questionNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "eventId", "eventTitle", "attendeeName", "attendanceMode", "questionNote", "createdAt"]
    },
    "ReadingProgress": {
      "title": "ReadingProgress",
      "description": "Cloud-synced Deep Reading Challenge completion state for a member.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "completedChallenges": {
          "type": "array",
          "maxLength": 12
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "completedChallenges", "updatedAt"]
    }
  },
  "firestore": {
    "/users_public/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public profile record for Vellune members without PII."
    },
    "/users_private/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Strictly private PII (email) accessible only to the owning verified user or admin."
    },
    "/saved_folios/{folioId}": {
      "schema": { "$ref": "#/entities/SavedFolio" },
      "description": "Personal Commonplace Book saved readings and private margin notes."
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/SubmissionRecord" },
      "description": "Member article pitches, fellowship applications, and chapter charters."
    },
    "/event_registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/EventRegistration" },
      "description": "Member seminar registrations for Vellune Conversations."
    },
    "/reading_progress/{userId}": {
      "schema": { "$ref": "#/entities/ReadingProgress" },
      "description": "Member progress in the Vellune Four-Quarter Deep Reading Challenge."
    }
  }
}
